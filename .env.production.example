# Copy to `.env.production` (or set these in CI) before `npm run build` / `pnpm build`.
# Vite bakes `VITE_*` into the bundle — never use localhost here (that becomes every user’s PC).

# Public API origin (no trailing slash). Must be reachable from the browser (CORS + HTTPS if your site is HTTPS).
VITE_API_URL=http://103.174.102.70:5002

# Cloudflare Turnstile site key (pair with TURNSTILE_SECRET_KEY on the API server)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADUUQVVNPv0m9dh-
