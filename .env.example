# Copy to `.env` and adjust (`.env` is gitignored).

# Dev: Vite proxies `/api/*` to this origin (must match your API host + port).
# Examples: http://localhost:5002  or  http://103.174.102.70:5002
VITE_API_PROXY_TARGET=

# Production builds (`vite build`): set `VITE_API_URL` to your real API (see `.env.production.example`).
# Never commit `http://localhost:...` — it is baked into JS and every user hits their own machine → ERR_CONNECTION_REFUSED.
# In local dev, leave EMPTY so `/api/...` uses the Vite proxy (`VITE_API_PROXY_TARGET`).
VITE_API_URL=

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public (baked into the frontend build). Secret stays on the API server only.
#
# IMPORTANT: In Turnstile → your widget → Hostname Management, add every origin you use, e.g.:
#   localhost, 127.0.0.1, 103.174.102.70, preview.lovable.app, manageadmin.tech2globe.ai
# Error 600010 / "Verification failed" usually means the current hostname is NOT in that list.
#
# Local dev without hostname setup — use Cloudflare test keys (always pass on any host):
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   (API server) TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADUUQVVNPv0m9dh-
