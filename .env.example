# Copy to `.env` and adjust (`.env` is gitignored).

# Dev only: backend origin for Vite’s `/api` proxy (protocol + host + port, no path).
# Example: https://api.mycompany.com:5001
VITE_API_PROXY_TARGET=

# Optional: absolute API base for production builds (no trailing slash).
# Leave empty to call `/api/...` on the same origin as the site.
VITE_API_URL=
